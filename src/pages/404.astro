---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title={`Page not found | ${site.name}`} description="This page does not exist.">
  <section class="page-hero">
    <div class="container">
      <p class="kicker">404</p>
      <h1>This page does not exist</h1>
      <p class="dek">It may have moved. The <a href="/">home page</a> links to everything on the site.</p>
    </div>
  </section>
</Base>
